# ==========================================
# Application Configuration & Secrets
# ==========================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=otet_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DATABASE_URL=jdbc:postgresql://localhost:5432/otet_db

# Spring Boot Server
SERVER_PORT=8080
JWT_SECRET=supersecretjwtkeythatisatleast32characterslong12345!
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app

# Optional AI Extraction Key (Never commit real keys!)
GEMINI_API_KEY=your_gemini_api_key_here
